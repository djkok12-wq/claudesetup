# KPC HR SYSTEM — systemd 서비스 (리눅스 서버에서 상시 실행)
# 설치:
#   sudo cp kpc-hr.service /etc/systemd/system/
#   sudo cp kpc-hr.env.example /etc/kpc-hr.env && sudo chmod 600 /etc/kpc-hr.env   # 값 채우기
#   sudo systemctl daemon-reload && sudo systemctl enable --now kpc-hr
# 백엔드 코드를 고친 뒤:
#   sudo systemctl restart kpc-hr        ← 이걸 해야 반영된다
# 로그:
#   journalctl -u kpc-hr -f

[Unit]
Description=KPC HR SYSTEM (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kpc
Group=kpc
WorkingDirectory=/srv/kpc-hr-system-v2
EnvironmentFile=/etc/kpc-hr.env
ExecStart=/srv/kpc-hr-system-v2/.venv/bin/python run.py
Restart=always
RestartSec=3

# 데이터 디렉터리만 쓰기 허용
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/kpc

[Install]
WantedBy=multi-user.target
