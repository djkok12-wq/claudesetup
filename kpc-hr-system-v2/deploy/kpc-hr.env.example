# /etc/kpc-hr.env  (chmod 600 — 세션 키가 들어가므로 git 에 올리지 않는다)

# 세션 쿠키 서명 키: 32자 이상 임의 문자열. 바꾸면 전원 로그아웃된다.
#   생성: python -c "import secrets;print(secrets.token_hex(32))"
KPC_SECRET=여기에_랜덤_64자

# HTTPS 로만 쿠키 전송 (리버스 프록시 + 인증서 붙인 뒤 반드시 1)
KPC_SECURE_COOKIE=1

# 외부에 직접 노출하지 않고 리버스 프록시만 접속하게 한다
KPC_HOST=127.0.0.1
KPC_PORT=8000

# SQLite DB 위치 = 백업 대상
KPC_DATA_DIR=/var/lib/kpc

# /api/docs 비공개
KPC_DOCS=0

# 운영에서는 절대 1로 두지 않는다 (코드 변경 자동 재적용 = 개발용)
KPC_RELOAD=0
